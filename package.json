{
  "name": "@jeroenzwart/istanbun",
  "version": "1.0.1",
  "description": "Istanbul coverage reporters for bun test",
  "keywords": [
    "bun",
    "coverage",
    "istanbul",
    "lcov",
    "reporter",
    "test"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeroenzwart/istanbun.git"
  },
  "type": "module",
  "bin": {
    "istanbun": "dist/bin/istanbun.js"
  },
  "main": "./dist/src/index.cjs",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "require": {
        "types": "./dist/src/index.d.cts",
        "default": "./dist/src/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "shipmark release"
  },
  "dependencies": {
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@grazulex/shipmark": "^2.1.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "1.4.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bunup": "^0.16.32",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
